{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), usb=()"
        }
      ]
    },
    {
      "source": "/:path(members|thanks|contact-thanks|demos)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/auth/callback",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/:page(listen|voice|join|contact)",
      "destination": "/:page.html"
    },
    {
      "source": "/:path(members|thanks|contact-thanks|demos)",
      "destination": "/"
    },
    {
      "source": "/auth/callback",
      "destination": "/"
    }
  ]
}
